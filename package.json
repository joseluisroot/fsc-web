{
  "name": "fsc-web",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend prototype for the Federación Salvadoreña de Ciclismo",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.build.config.cjs -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.generated.css --minify",
    "watch:css": "tailwindcss -c tailwind.build.config.cjs -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.generated.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.17"
  }
}
